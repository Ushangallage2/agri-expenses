# PostgreSQL connection (Aiven free tier, or local).
# Hosted Aiven URIs should include ?sslmode=require
DATABASE_URL=postgres://USER@HOST:5432/DATABASE

# Used to sign login cookies
JWT_SECRET=change-me-to-a-long-random-string

# Ledger email reports (Mailtrap Email Sending API). Leave unset to skip mail.
# MAILTRAP_API_TOKEN=
# MAIL_FROM_EMAIL=
# MAIL_FROM_NAME=Agri Ledger
# APP_URL=https://agri-expenses.netlify.app
